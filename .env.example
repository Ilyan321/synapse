# Groq API Configuration
# Multi-key rotation pool (comma-separated) to prevent 429 rate limit errors
GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2,gsk_your_key_3

# Groq Model Defaults
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
GROQ_AGENT_MODEL=llama-3.3-70b-versatile

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Slack Bolt Configuration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-level-token-for-socket-mode
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Execution & Sandbox Configuration
PYTHON_EXECUTION_MODE=subprocess # options: subprocess, e2b
E2B_API_KEY=e2b_your_api_key_optional
EXECUTION_TIMEOUT_SECONDS=15
